{
  "opencollection": "1.0.0",
  "info": {
    "name": "Event API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Event",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "PostUserEvent",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox-evt.mcm-api.moloco.com/rmp/event/v1/platforms/:platform/userevents",
            "params": [
              {
                "name": "platform",
                "value": "",
                "type": "path",
                "description": "Platform for the user event."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Post an individual user event. Server host may vary by platform. Moloco's account manager will provide accurate host information."
        }
      ]
    }
  ],
  "bundled": true
}