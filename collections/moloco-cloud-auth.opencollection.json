        {
          "info": {
            "name": "Delete the user password.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://morse-us-prod.adsmoloco.com/v1/users/:email/password",
            "params": [
              {
                "name": "email",
                "value": "",
                "type": "path",
                "description": "The email address of the user."
              },
              {
                "name": "userspace_id",
                "value": "",
