    {
      "info": {
        "name": "User",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List users.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://morse-us-prod.adsmoloco.com/v1/users",
            "params": [
              {
                "name": "platform_id",
                "value": "",
                "type": "query",
                "description": "The ID of the platform to search users."
              },
              {
                "name": "userspace_id",
                "value": "",
                "type": "query",
                "description": "The ID of the userspace to search users."
              },
              {
                "name": "email",
                "value": "",
                "type": "query",
                "description": "The email address of a user to search."
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "The name of the users to search."
              },
              {
                "name": "filter_role",
                "value": "",
                "type": "query",
                "description": "Filter the users with this role."
              },
              {
                "name": "match_role",
                "value": "",
                "type": "query",
                "description": "Select the users with this role."
              },
              {
                "name": "with_roles",
                "value": "",
                "type": "query",
                "description": "If set to true, the role names granted to each user will be returned as well.\nWhen this parameter is used, the platform_id should be given as well because\nrole grant is done under a specific platform.\n"
              },
              {
                "name": "with_status",
                "value": "",
                "type": "query",
                "description": "If set to true, the status of each user will be returned as well."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "List users matching the given condition."
        },
        {
          "info": {
            "name": "Create a new user.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://morse-us-prod.adsmoloco.com/v1/users",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Create a new user in a given userspace."
