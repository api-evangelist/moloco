      "items": [
        {
          "info": {
            "name": "Get the list of ad account users.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://morse-us-prod.adsmoloco.com/v1/ad-accounts/:ad_account_id/users",
            "params": [
              {
                "name": "ad_account_id",
                "value": "",
                "type": "path",
                "description": "The Ad Account ID."
              },
              {
                "name": "platform_id",
                "value": "",
                "type": "query",
                "description": "Platform ID."
              },
              {
                "name": "with_status",
                "value": "",
                "type": "query",
                "description": "If given, the result will include the user status info."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Get the list of users registered to the given ad account."
        },
        {
          "info": {
            "name": "Register a user to an ad account.",
            "type": "http"
