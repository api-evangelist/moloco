          },
          "http": {
            "method": "DELETE",
            "url": "https://morse-us-prod.adsmoloco.com/v1/ad-accounts/:ad_account_id/users/:user_id",
            "params": [
              {
                "name": "ad_account_id",
                "value": "",
                "type": "path",
                "description": "The Ad Account to which the user was registered."
